# Where the experiment store lives: expc.duckdb, truth.duckdb, units/ and daily/ go here.
EXPC_DATA_DIR=data

# LLM (Phase 4 on): any OpenAI-compatible endpoint. Defaults are DeepSeek.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# Thinking effort: low | high | max
LLM_REASONING_EFFORT=high

# Judge for explanation quality (Phase 5). Must differ from LLM_MODEL.
JUDGE_MODEL=deepseek-flash
